      <aliases enabled='yes' />
      <column caption='Review performace score' datatype='integer' name='[Calculation_1509677307428864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Review Scores Rating]*[Number Of Reviews]' />
      </column>
      <column caption='total price' datatype='integer' name='[Calculation_1509677308510209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Price])' />
      </column>
      <column caption='Pricing category' datatype='string' name='[Calculation_1509677310304258]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;=300 THEN &quot;LUXURY&quot;&#13;&#10;ELSEIF [Price]&gt;=150 THEN &quot;STANDARD&quot;&#13;&#10;ELSE &quot;BUDGET&quot;&#13;&#10;END' />
      </column>
      <column caption='Review category' datatype='string' name='[Calculation_1509677313216515]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews]&gt;= 100 THEN &quot;highly reviewed&quot;&#13;&#10;ELSE &quot;less reviewed&quot;&#13;&#10;END' />
      </column>
      <column caption='host status' datatype='string' name='[Calculation_1509677314383876]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since] &lt;= TODAY() THEN &quot;Active host&quot;&#13;&#10;ELSE&quot;New host&quot;&#13;&#10;END' />
      </column>
      <column caption='Average review score rating' datatype='real' name='[Calculation_1509677316116485]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Review Scores Rating])' />
      </column>
      <column caption='Price filter category' datatype='string' name='[Calculation_1509677320888328]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; [Parameters].[Parameter 1509677318070278] THEN  &quot;Above limit&quot;&#13;&#10;ELSE &quot;Below limit&quot;&#13;&#10;END' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column caption='Neighbourhood' datatype='string' name='[Neighbourhood ]' role='dimension' type='nominal' />
      <column datatype='integer' name='[Price]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Review Scores Rating]' role='measure' type='quantitative' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
